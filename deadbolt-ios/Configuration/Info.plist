<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ASCredentialProviderExtensionCapabilities</key>
	<dict>
		<key>ProvidesPasskeys</key>
		<true/>
		<key>ProvidesPasswords</key>
		<true/>
		<key>SupportedCredentialExchangeVersions</key>
		<array>
			<string>1.0</string>
		</array>
		<key>SupportsCredentialExchange</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>Deadbolt</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DeadboltKeychainGroup</key>
	<string>$(AppIdentifierPrefix)dev.zackbart.deadbolt.shared</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your encrypted Deadbolt vault.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivity</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Deadbolt connects to your trusted devices to pair and sync your encrypted vault.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
